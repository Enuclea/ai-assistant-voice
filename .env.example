# ============================================================================
# ai-assistant-voice — Example Configuration
# Copy to .env and fill in values. NEVER commit real secrets to git.
# ============================================================================

# --- 1. VoIP / SIP Trunk Configuration (e.g. VoIP.ms) -----------------------
AI_VOICE_ENABLED=true
# Pick the VoIP.ms POP closest to your host (e.g. washington2.voip.ms, atlanta1.voip.ms, toronto1.voip.ms)
VOIPMS_SIP_SERVER=washington2.voip.ms
VOIPMS_SIP_PORT=5061
VOIPMS_SIP_TRANSPORT=tls
# Use a dedicated Sub-Account username (e.g. 100000_voicebot), NOT your main account
VOIPMS_SIP_USERNAME=100000_voicebot
VOIPMS_SIP_PASSWORD=replace-with-subaccount-sip-password
# Your 10-digit E.164 DID number
VOIPMS_DID=+15551234567

# UDP port range forwarded from your firewall/NAT to this container for SRTP media
AI_VOICE_RTP_PORT_START=30000
AI_VOICE_RTP_PORT_END=30100

# --- 2. Realtime Voice LLM Provider -----------------------------------------
# Supported: gemini (gemini-3.8-live) | grok (wss://api.x.ai/v1/realtime) | openai
AI_VOICE_PROVIDER=gemini
AI_VOICE_MODEL=gemini-3.8-live
AI_VOICE_NAME=Aoede
GEMINI_API_KEY=replace-with-gemini-api-key
XAI_API_KEY=replace-with-optional-xai-api-key
OPENAI_API_KEY=replace-with-optional-openai-api-key

# --- 3. Receptionist & Owner Escalation Settings ----------------------------
AI_VOICE_ASSISTANT_NAME=Lexie
AI_VOICE_COMPANY_NAME=Example Organization
AI_VOICE_COMPANY_BRIEF="We provide 24/7 engineering and cloud operations."
AI_VOICE_OWNER_TRANSFER_NUMBER=+15559990000

# --- 4. MCP & HTTP Server Security (Safe Defaults) --------------------------
# Transport mode: stdio (for local Desktop agents) | http (for Remote MCP + REST API)
AI_VOICE_TRANSPORT=stdio
# Bind loopback by default; set to 0.0.0.0 only behind TLS reverse proxy / Cloudflare Tunnel
AI_VOICE_BIND_HOST=127.0.0.1
AI_VOICE_BIND_PORT=8400
# Mandatory 32+ char Bearer secret when using HTTP transport
AI_VOICE_MCP_TOKEN=replace-with-at-least-32-bytes-of-random-hex-secret
# Optional public origin for OAuth 2.1 Protected Resource Metadata (RFC 9728)
AI_VOICE_PUBLIC_ORIGIN=https://voice-mcp.example.com
# Optional comma-separated allowed Origin headers for Remote MCP
AI_VOICE_ALLOWED_ORIGINS=https://claude.ai,https://grok.com,https://chatgpt.com

# --- 5. PSTN Toll-Fraud & Rate-Limit Guards ---------------------------------
# International dialing (non-+1 E.164) is disabled by default
AI_VOICE_ALLOW_INTERNATIONAL=false
# Optional comma-separated E.164 prefixes/numbers permitted for outbound calls (empty = all standard US/CA numbers allowed)
AI_VOICE_OUTBOUND_ALLOWLIST=
AI_VOICE_MAX_CALLS_PER_HOUR=20
AI_VOICE_MAX_SMS_PER_HOUR=30
